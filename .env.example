# =========================
# OpenAI
# =========================

# Your OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# =========================
# Embeddings
# =========================

# Device used for embedding generation.
# Options: cpu, cuda, mps
EMBEDDING_DEVICE=cpu

# =========================
# Langfuse (optional)
# =========================

# Tracing is enabled when both keys are set; leave them empty to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse Cloud (EU) by default; use https://us.cloud.langfuse.com or a
# self-hosted URL such as http://localhost:3000.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
